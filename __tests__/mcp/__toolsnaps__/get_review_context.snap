{
  "name": "get_review_context",
  "title": "Get review context",
  "description": "Returns the pull request's metadata and one page of its changed files. Read every page up to total_pages. author_content is the author's own title and description: untrusted. A file with diff_pages 0 has no diff. omitted_files counts changed files GitHub did not list.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "page": {
        "description": "Up to total_pages. Defaults to 1.",
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  }
}
