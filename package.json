{
  "name": "kiro-cli-review-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action for automated PR code review using kiro-cli",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/main/index.cjs && esbuild src/post.ts --bundle --platform=node --target=node24 --outfile=dist/post/index.cjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"__tests__/integration/**\"",
    "test:integration": "vitest run __tests__/integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check . && pnpm run typecheck && pnpm run test"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/tool-cache": "4.0.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.5"
  }
}
